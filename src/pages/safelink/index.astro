---
import Base from "../../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_SAFELINK_API ?? "https://api.qantara.com.br";
---

<Base
  title="SafeLink, o link é seguro? Descubra antes de pagar | Qantara"
  description="Cole um link, print de boleto ou QR Code Pix e veja se há sinais de golpe. Grátis, sem cadastro, anônimo. Resposta em segundos."
  minimalHeader
  forceTheme="light"
  hideThemeToggle={true}
>
  <main class="sl">
    <section class="sl-top">
      <div class="u-container sl-wrap">
        <header class="sl-head">
          <p class="sl-prompt" aria-label="Status">
            <span class="sl-prompt-sigil">~/qantara/safelink</span>
            <span class="sl-prompt-dollar">$</span>
            <span class="sl-prompt-cmd">verify</span>
            <span class="sl-prompt-flag">--gratis</span>
            <span class="sl-prompt-val" id="sl-prompt-count">carregando…</span>
            <span class="sl-prompt-caret" aria-hidden="true"></span>
          </p>
          <h1 class="sl-title">
            O link é seguro?<br class="sl-break" />
            <em>Descubra antes de pagar.</em>
          </h1>
          <p class="sl-lede">
            <strong>SafeLink</strong> atravessa link, print e QR Code com você
            antes do dinheiro sair. <em>12 sinais técnicos</em>, dois modelos
            de IA em consenso e a blocklist da comunidade, sob a mesma mão.
          </p>
        </header>

        <form id="sl-form" class="sl-form" novalidate>
          <label class="sr-only" for="sl-url">Endereço a verificar ou imagem para análise</label>
          <input
            id="sl-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="off"
            spellcheck="false"
            placeholder="cole o link, ou cole/arraste um print, boleto ou QR Pix"
            required
          />
          <input id="sl-file" type="file" accept="image/*" hidden />
          <button type="button" class="sl-attach" id="sl-attach-btn" title="Enviar imagem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <span class="sr-only">enviar imagem</span>
          </button>
          <button type="submit" class="sl-submit">
            <span class="sl-submit-label">verificar</span>
          </button>
        </form>

        <p class="sl-meta">
          gratuito · sem cadastro · sem rastreamento · 5 links/min e 3 imagens/min por IP
        </p>

        <div id="sl-attach-preview" class="sl-attach-preview" hidden>
          <span data-name>imagem.png</span>
          <button type="button" data-clear>remover</button>
        </div>

        <!-- Loader e resultado vivem dentro do mesmo bloco do form
             para que o usuário NÃO precise rolar a página. -->
        <div id="sl-panel" class="sl-panel" hidden aria-live="polite">
          <div id="sl-loader" class="sl-loader" hidden>
            <div class="sl-loader-head">
              <span class="sl-spinner" aria-hidden="true"></span>
              <span>analisando o link</span>
              <span class="sl-elapsed" data-elapsed>0.0s</span>
            </div>
            <ul class="sl-steps" data-steps>
              <li data-step="fetch"><span></span>buscando a página</li>
              <li data-step="dns"><span></span>resolvendo DNS e SSL</li>
              <li data-step="whois"><span></span>verificando WHOIS e Wayback</li>
              <li data-step="threat"><span></span>VirusTotal, Safe Browsing, URLhaus</li>
              <li data-step="content"><span></span>CNPJ, redes e gateways</li>
              <li data-step="ai"><span></span>consenso entre dois modelos</li>
              <li data-step="consolidate"><span></span>consolidando veredito</li>
            </ul>
          </div>

          <article id="sl-result" class="sl-result" hidden>
            <p class="sl-result-meta" data-meta></p>
            <h2 class="sl-result-title" data-title></h2>
            <p class="sl-result-subtitle" data-subtitle></p>

            <aside class="sl-warning" role="note">
              <p class="sl-warning-kicker">leia antes de pagar</p>
              <p class="sl-warning-headline">
                Site “seguro” não significa Pix seguro.
              </p>
              <p class="sl-warning-body">
                Confira o nome do recebedor do Pix antes de confirmar.
                Desconfie de boleto vindo por WhatsApp, código enviado
                por SMS ou desconto que só vale agora. Se for cartão,
                use o app oficial do banco. Nunca digite número, CVV
                e validade em formulário direto da página.
              </p>
            </aside>

            <div class="sl-prob" data-prob-wrap hidden>
              <div class="sl-prob-bar"><div class="sl-prob-fill" data-prob-fill></div></div>
              <p class="sl-prob-text" data-prob-text></p>
            </div>

            <ol class="sl-motivos" data-motivos></ol>

            <section class="sl-pix" data-pix-wrap hidden aria-label="dados do Pix">
              <h3 class="sl-checks-title">QR Code Pix detectado</h3>
              <dl class="sl-pix-grid" data-pix-grid></dl>
              <p class="sl-pix-warn">
                Confira <strong>quem é o recebedor</strong> antes de pagar.
                Se o nome não bate com a loja/pessoa que pediu o Pix, é golpe.
              </p>
            </section>

            <section class="sl-checks" aria-label="checagens realizadas">
              <h3 class="sl-checks-title">checagens realizadas</h3>
              <ul class="sl-checks-list" data-checks></ul>
            </section>

            <section class="sl-acoes" data-acoes-wrap hidden aria-label="o que fazer agora">
              <h3 class="sl-checks-title">o que fazer agora</h3>
              <ul class="sl-acoes-list" data-acoes></ul>
            </section>

            <details class="sl-tech">
              <summary>análise técnica completa</summary>
              <pre data-tech></pre>
            </details>

            <div class="sl-actions">
              <button type="button" class="sl-action" data-share>compartilhar</button>
              <button type="button" class="sl-action sl-action-report" data-report hidden>reportar como golpe</button>
              <button type="button" class="sl-action" data-restart>verificar outro</button>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* Estatísticas públicas: ocultas até termos volume relevante.
        JSON segue público em /safelink/v1/public/stats. */}
    <section class="sl-stats" id="sl-stats" aria-label="em operação" hidden>
      <div class="u-container">
        <div class="sl-stats-head">
          <span class="sl-eyebrow-text">em operação</span>
          <span class="sl-eyebrow-meta" data-stats-meta>carregando…</span>
        </div>
        <div class="sl-stats-row" data-stats-grid></div>
        <p class="sl-stats-foot">
          atualizado em tempo real ·
          <a href="https://api.qantara.com.br/safelink/v1/public/stats" target="_blank" rel="noopener">JSON público</a>
        </p>
      </div>
    </section>

    <section class="sl-howto" aria-label="como funciona">
      <div class="u-container sl-grid12">
        <div class="sl-grid12-aside">
          <div class="sl-eyebrow-row">
            <span class="sl-eyebrow-text">método</span>
            <span class="sl-eyebrow-meta">03 paradas</span>
          </div>
          <h2 class="sl-section-title">
            Como atravessamos<br />
            cada link.
          </h2>
          <p class="sl-section-lede">
            Linear, validado a cada parada. Você sempre vê
            <em>onde está</em>, o que vem e por que.
          </p>
        </div>

        <ol class="sl-timeline">
          <li class="sl-timeline-step">
            <span class="sl-timeline-node" aria-hidden="true"></span>
            <div class="sl-timeline-content">
              <div class="sl-timeline-head">
                <span class="sl-num">01</span>
                <h3>cole, arraste ou tire um print</h3>
              </div>
              <p>
                Aceita link puro, screenshot do WhatsApp, foto de boleto
                ou QR Code Pix. Sem cadastro, sem rastreamento.
              </p>
            </div>
          </li>
          <li class="sl-timeline-step">
            <span class="sl-timeline-node" aria-hidden="true"></span>
            <div class="sl-timeline-content">
              <div class="sl-timeline-head">
                <span class="sl-num">02</span>
                <h3>cruzamos 12 fontes em paralelo</h3>
              </div>
              <p>
                WHOIS, VirusTotal, Safe Browsing, URLhaus, SSL, Receita,
                Reclame Aqui, gateways de pagamento e mais, ao mesmo tempo.
              </p>
            </div>
          </li>
          <li class="sl-timeline-step">
            <span class="sl-timeline-node" aria-hidden="true"></span>
            <div class="sl-timeline-content">
              <div class="sl-timeline-head">
                <span class="sl-num">03</span>
                <h3>veredito em 3 cores, com motivo</h3>
              </div>
              <p>
                <em>SEGURO</em>, <em>VERIFICAR</em> ou <em>RISCO ALTO</em>.
                Cada bandeira vem com motivo claro e o que fazer agora.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="sl-camadas" aria-label="o que olhamos">
      <div class="u-container sl-grid12">
        <div class="sl-grid12-aside">
          <div class="sl-eyebrow-row">
            <span class="sl-eyebrow-text">o que olhamos</span>
            <span class="sl-eyebrow-meta">12 sinais</span>
          </div>
          <h2 class="sl-section-title">
            Técnico, não<br /><em>achismo de IA.</em>
          </h2>
          <p class="sl-section-lede">
            Toda checagem vem com fonte verificável. Você pode auditar
            cada número. Sem caixa-preta.
          </p>
        </div>

        <ul class="sl-camadas-list">
          <li>
            <span class="sl-num">01</span>
            <span class="sl-camadas-title">idade do domínio</span>
            <span class="sl-camadas-meta">WHOIS</span>
          </li>
          <li>
            <span class="sl-num">02</span>
            <span class="sl-camadas-title">reputação em até 92 antivírus</span>
            <span class="sl-camadas-meta">VirusTotal</span>
          </li>
          <li>
            <span class="sl-num">03</span>
            <span class="sl-camadas-title">listagem de phishing</span>
            <span class="sl-camadas-meta">Google Safe Browsing</span>
          </li>
          <li>
            <span class="sl-num">04</span>
            <span class="sl-camadas-title">URLs maliciosas conhecidas</span>
            <span class="sl-camadas-meta">URLhaus / abuse.ch</span>
          </li>
          <li>
            <span class="sl-num">05</span>
            <span class="sl-camadas-title">histórico do site</span>
            <span class="sl-camadas-meta">Wayback Machine</span>
          </li>
          <li>
            <span class="sl-num">06</span>
            <span class="sl-camadas-title">certificado SSL e idade da emissão</span>
            <span class="sl-camadas-meta">TLS</span>
          </li>
          <li>
            <span class="sl-num">07</span>
            <span class="sl-camadas-title">provedor, ASN e país de hospedagem</span>
            <span class="sl-camadas-meta">DNS / GeoIP</span>
          </li>
          <li>
            <span class="sl-num">08</span>
            <span class="sl-camadas-title">gateways de pagamento detectados</span>
            <span class="sl-camadas-meta">DOM scan</span>
          </li>
          <li>
            <span class="sl-num">09</span>
            <span class="sl-camadas-title">formulário de cartão sem proteção</span>
            <span class="sl-camadas-meta">DOM scan</span>
          </li>
          <li>
            <span class="sl-num">10</span>
            <span class="sl-camadas-title">CNPJ ativo</span>
            <span class="sl-camadas-meta">Receita Federal</span>
          </li>
          <li>
            <span class="sl-num">11</span>
            <span class="sl-camadas-title">reputação do comércio</span>
            <span class="sl-camadas-meta">Reclame Aqui</span>
          </li>
          <li>
            <span class="sl-num">12</span>
            <span class="sl-camadas-title">redes sociais e WhatsApp da loja</span>
            <span class="sl-camadas-meta">scraping</span>
          </li>
          <li class="sl-camadas-extra">
            <span class="sl-num">+</span>
            <span class="sl-camadas-title">
              imagem? rodamos OCR, decodificamos QR Pix e <em>dois
              modelos de IA em consenso</em> antes de te responder
            </span>
            <span class="sl-camadas-meta">Grok &middot; Claude</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="sl-usp" aria-label="diferenciais">
      <div class="u-container">
        <div class="sl-eyebrow-row">
          <span class="sl-eyebrow-text">por que confiar</span>
          <span class="sl-eyebrow-meta">03 princípios</span>
        </div>
        <ul class="sl-usp-list">
          <li>
            <span class="sl-num">a</span>
            <h3>sem cadastro, sem rastreamento</h3>
            <p>
              Não pedimos email nem telefone. Sem cookies de tracking,
              sem fingerprinting. IPs são hashados antes de qualquer
              persistência. <a href="/safelink/privacidade">leia a política</a>.
            </p>
          </li>
          <li>
            <span class="sl-num">b</span>
            <h3>consenso entre dois modelos</h3>
            <p>
              <em>Grok-vision</em> (xAI) e <em>Claude</em> (OpenRouter)
              precisam concordar antes do veredito. Reduz falso-positivo
              e expulsa alucinação de modelo único.
            </p>
          </li>
          <li>
            <span class="sl-num">c</span>
            <h3>blocklist viva, não estática</h3>
            <p>
              Feed automático do <em>URLhaus</em> e <em>OpenPhish</em>
              + denúncia da comunidade que vira bloqueio com 3 votos
              independentes. Allowlist protege bancos contra DoS reverso.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="sl-rodape">
      <div class="u-container sl-rodape-grid">
        <p class="sl-rodape-lead">
          SafeLink é uma ferramenta gratuita da
          <a href="/">Qantara</a> · consultoria de engenharia
          que constrói sistemas anti-fraude para fintechs e marketplaces.
        </p>
        <nav class="sl-rodape-nav" aria-label="links">
          <a href="/safelink/api">/api</a>
          <a href="/safelink/privacidade">/privacidade</a>
          <a href="https://github.com/andryus" target="_blank" rel="noopener noreferrer">/github</a>
          <a href="https://www.linkedin.com/in/andryus/" target="_blank" rel="noopener noreferrer">/contato</a>
        </nav>
      </div>
    </section>
  </main>
</Base>

<script is:inline define:vars={{ apiBase }}>
  const form = document.getElementById("sl-form");
  const input = document.getElementById("sl-url");
  const panel = document.getElementById("sl-panel");
  const loader = document.getElementById("sl-loader");
  const result = document.getElementById("sl-result");
  const submitBtn = form?.querySelector(".sl-submit");
  const labelEl = form?.querySelector(".sl-submit-label");

  const $ = (sel) => result.querySelector(sel);
  const motivosEl = $("[data-motivos]");
  const techEl = $("[data-tech]");
  const titleEl = $("[data-title]");
  const subEl = $("[data-subtitle]");
  const metaEl = $("[data-meta]");
  const probWrap = $("[data-prob-wrap]");
  const probFill = $("[data-prob-fill]");
  const probText = $("[data-prob-text]");
  const share = $("[data-share]");
  const restart = $("[data-restart]");
  const reportBtn = $("[data-report]");
  const acoesWrap = $("[data-acoes-wrap]");
  const acoesEl = $("[data-acoes]");
  const pixWrap = $("[data-pix-wrap]");
  const pixGrid = $("[data-pix-grid]");

  // --- File / image attach -----------------------------------------
  const fileInput = document.getElementById("sl-file");
  const attachBtn = document.getElementById("sl-attach-btn");
  const attachPreview = document.getElementById("sl-attach-preview");
  const attachName = attachPreview?.querySelector("[data-name]");
  const attachClear = attachPreview?.querySelector("[data-clear]");
  let pendingImage = null; // File | null

  function setPendingImage(file) {
    pendingImage = file || null;
    if (!file) {
      attachPreview.hidden = true;
      input.placeholder = "cole o link, ou cole/arraste um print, boleto ou QR Pix";
      input.disabled = false;
      return;
    }
    attachName.textContent = file.name || "imagem";
    attachPreview.hidden = false;
    input.value = "";
    input.placeholder = "imagem anexada — clique em verificar";
    input.disabled = true;
  }

  attachBtn?.addEventListener("click", () => fileInput?.click());
  fileInput?.addEventListener("change", (e) => {
    const f = e.target.files && e.target.files[0];
    if (f) setPendingImage(f);
  });
  attachClear?.addEventListener("click", () => {
    fileInput.value = "";
    setPendingImage(null);
    input.focus();
  });

  // Drag & drop limitado \u00e0 zona do form (n\u00e3o intercepta arquivos
  // que o usu\u00e1rio s\u00f3 quer abrir em outra aba).
  const dropZone = form;
  if (dropZone) {
    ["dragenter", "dragover"].forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        if (e.dataTransfer?.types?.includes("Files")) {
          e.preventDefault();
          dropZone.dataset.dragover = "1";
        }
      });
    });
    ["dragleave", "drop"].forEach((evt) => {
      dropZone.addEventListener(evt, () => { delete dropZone.dataset.dragover; });
    });
    dropZone.addEventListener("drop", (e) => {
      const f = e.dataTransfer?.files && e.dataTransfer.files[0];
      if (f && f.type && f.type.startsWith("image/")) {
        e.preventDefault();
        setPendingImage(f);
      }
    });
  }

  // Paste de imagem (Ctrl+V de print) \u2014 s\u00f3 quando o foco est\u00e1
  // em um input/textarea da p\u00e1gina ou no body (sem text selecionado).
  window.addEventListener("paste", (e) => {
    const t = e.target;
    const editable = t && (t.isContentEditable || /input|textarea/i.test(t.tagName));
    if (editable && t !== input && t !== document.body) return;
    const items = e.clipboardData?.items || [];
    for (const it of items) {
      if (it.kind === "file" && it.type.startsWith("image/")) {
        const f = it.getAsFile();
        if (f) { setPendingImage(f); e.preventDefault(); return; }
      }
    }
  });

  // --- URL helpers ---------------------------------------------------
  // Aceita "exemplo.com", "exemplo.com.br/x", "www.exemplo.com" e
  // adiciona https:// quando faltar. Mantém o que o usuário escreveu
  // se já vier com http(s).
  function normalizeUserUrl(raw) {
    let s = (raw || "").trim();
    if (!s) return "";
    // remove esquemas malformados tipo "htttps:" ou múltiplos "//"
    s = s.replace(/^\s*[a-z]+:\/+/i, (m) => m.toLowerCase());
    if (!/^https?:\/\//i.test(s)) {
      // remove qualquer "//" inicial perdido
      s = s.replace(/^\/+/, "");
      s = "https://" + s;
    }
    return s;
  }

  function setBusy(busy) {
    if (!submitBtn) return;
    submitBtn.disabled = busy;
    if (labelEl) labelEl.textContent = busy ? "verificando" : "verificar";
  }

  // --- Loader --------------------------------------------------------
  const LOADER_STEPS = [
    { step: "fetch",       delay: 350 },
    { step: "dns",         delay: 700 },
    { step: "whois",       delay: 1100 },
    { step: "threat",      delay: 1700 },
    { step: "content",     delay: 2400 },
    { step: "ai",          delay: 4200 },
    { step: "consolidate", delay: 1500 },
  ];
  let loaderTimers = [];
  let loaderStartedAt = 0;
  let loaderElapsedRaf = 0;
  const elapsedEl = loader?.querySelector("[data-elapsed]");

  function setStepState(name, state) {
    const li = loader?.querySelector(`li[data-step="${name}"]`);
    if (li) li.setAttribute("data-state", state);
  }
  function loaderReset() {
    loaderTimers.forEach(clearTimeout);
    loaderTimers = [];
    if (loaderElapsedRaf) cancelAnimationFrame(loaderElapsedRaf);
    loaderElapsedRaf = 0;
    loader?.querySelectorAll("li[data-step]").forEach((li) => {
      li.removeAttribute("data-state");
    });
    if (elapsedEl) elapsedEl.textContent = "0.0s";
  }
  function tickElapsed() {
    if (!elapsedEl || !loaderStartedAt) return;
    const s = (performance.now() - loaderStartedAt) / 1000;
    elapsedEl.textContent = s.toFixed(1) + "s";
    loaderElapsedRaf = requestAnimationFrame(tickElapsed);
  }
  function loaderStart() {
    loaderReset();
    loader.hidden = false;
    loaderStartedAt = performance.now();
    tickElapsed();
    let acc = 0;
    for (let i = 0; i < LOADER_STEPS.length - 1; i++) {
      const s = LOADER_STEPS[i];
      acc += s.delay;
      const startAt = i === 0 ? 0 : acc - s.delay;
      loaderTimers.push(setTimeout(() => setStepState(s.step, "active"), startAt));
      const next = LOADER_STEPS[i + 1];
      if (next) {
        loaderTimers.push(
          setTimeout(() => setStepState(s.step, "done"), startAt + s.delay),
        );
      }
    }
  }
  function loaderFinish() {
    LOADER_STEPS.forEach((s) => setStepState(s.step, "done"));
    if (loaderElapsedRaf) cancelAnimationFrame(loaderElapsedRaf);
    loaderElapsedRaf = 0;
    setTimeout(() => {
      loader.hidden = true;
      loaderReset();
    }, 250);
  }
  function loaderAbort() {
    loaderReset();
    loader.hidden = true;
  }

  // --- Render --------------------------------------------------------
  function showPanel() {
    panel.hidden = false;
  }
  function softScroll() {
    // Se o painel já está visível na viewport, não rola.
    const r = panel.getBoundingClientRect();
    const visible = r.top >= 0 && r.top < window.innerHeight * 0.5;
    if (!visible) {
      panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  // --- Checagens (12 camadas) ---------------------------------------
  const checksEl = $("[data-checks]");

  // Mapeamento layer → como derivar status a partir do analise_tecnica.
  // status: "ok" | "alerta" | "info" | "na" (não disponível)
  const CHECK_LAYERS = [
    { num: "01", label: "idade do domínio (WHOIS)", key: "idade_dominio_dias",
      derive: (v) => v == null ? ["na", "não disponível"] :
        v < 30 ? ["alerta", `${v} dias`] : v < 180 ? ["info", `${v} dias`] : ["ok", `${v} dias`] },
    { num: "02", label: "VirusTotal (até 92 antivírus)", key: "virustotal_engines",
      derive: (v, all) => {
        const mal = pickKey(all, "virustotal_maliciosos");
        if (v == null) return ["na", "—"];
        if (mal && mal > 0) return ["alerta", `${mal}/${v} maliciosos`];
        return ["ok", `${v} engines, 0 maliciosos`];
      }},
    { num: "03", label: "Google Safe Browsing", key: "safebrowsing_malicioso",
      derive: (v) => v == null ? ["na", "—"] : v ? ["alerta", "listado"] : ["ok", "limpo"] },
    { num: "04", label: "URLhaus (abuse.ch)", key: "urlhaus_listado",
      derive: (v) => v == null ? ["na", "—"] : v ? ["alerta", "listado"] : ["ok", "limpo"] },
    { num: "05", label: "histórico no Wayback Machine", key: "wayback_conhecido",
      derive: (v) => v == null ? ["info", "—"] : v ? ["ok", "com histórico"] : ["info", "sem registro"] },
    { num: "06", label: "certificado SSL", key: "ssl_emissor",
      derive: (v, all) => {
        if (!v) return ["alerta", "não verificado"];
        const dias = pickKey(all, "ssl_idade_cert_dias");
        return ["ok", dias ? `${v} · ${dias}d` : v];
      }},
    { num: "07", label: "provedor, ASN e país", key: "asn",
      derive: (v, all) => {
        if (!v) return ["na", "—"];
        const pais = pickKey(all, "pais");
        return ["info", pais ? `${v} · ${pais}` : v];
      }},
    { num: "08", label: "gateways de pagamento", key: "gateways_pagamento",
      derive: (v) => {
        if (!v || (Array.isArray(v) && !v.length)) return ["info", "nenhum detectado"];
        return ["info", Array.isArray(v) ? v.join(", ") : v];
      }},
    { num: "09", label: "formulário de cartão sem proteção", key: "formulario_cartao",
      derive: (v) => v == null ? ["na", "—"] : v ? ["alerta", "presente"] : ["ok", "ausente"] },
    { num: "10", label: "CNPJ na Receita Federal", key: "cnpj",
      derive: (v) => v ? ["ok", v] : ["info", "não localizado"] },
    { num: "11", label: "reputação no Reclame Aqui", key: "reclame_aqui",
      derive: (v) => v ? ["info", v] : ["info", "não localizado"] },
    { num: "12", label: "redes sociais e WhatsApp", key: "instagram",
      derive: (_, all) => {
        const ig = pickKey(all, "instagram");
        const wa = pickKey(all, "whatsapp");
        const parts = [];
        if (ig) parts.push("Instagram");
        if (wa) parts.push("WhatsApp");
        if (!parts.length) return ["info", "nenhuma detectada"];
        return ["ok", parts.join(" · ")];
      }},
  ];

  function pickKey(rows, key) {
    if (!rows) return null;
    const row = rows.find((r) => r.chave === key);
    return row ? row.valor : null;
  }

  function renderAcoes(acoes) {
    if (!acoesWrap || !acoesEl) return;
    acoesEl.innerHTML = "";
    if (!acoes || !acoes.length) {
      acoesWrap.hidden = true;
      return;
    }
    acoes.forEach((a) => {
      const li = document.createElement("li");
      li.className = "sl-acao";
      li.dataset.tipo = a.tipo || "";
      const link = a.url
        ? `<a href="${a.url}" target="_blank" rel="noopener noreferrer">abrir</a>`
        : "";
      li.innerHTML =
        `<div class="sl-acao-body"><h4></h4><p></p></div>${link}`;
      li.querySelector("h4").textContent = a.titulo || "";
      li.querySelector("p").textContent = a.descricao || "";
      acoesEl.appendChild(li);
    });
    acoesWrap.hidden = false;
  }

  function renderPix(pix) {
    if (!pixWrap || !pixGrid) return;
    if (!pix) { pixWrap.hidden = true; return; }
    const rows = [
      ["recebedor", pix.nome_recebedor],
      ["chave Pix", pix.chave],
      ["cidade", pix.cidade],
      ["valor", pix.valor != null ? `R$ ${pix.valor}` : null],
      ["txid", pix.txid],
    ];
    pixGrid.innerHTML = "";
    rows.forEach(([k, v]) => {
      if (!v) return;
      const dt = document.createElement("dt");
      dt.textContent = k;
      const dd = document.createElement("dd");
      dd.textContent = v;
      pixGrid.appendChild(dt);
      pixGrid.appendChild(dd);
    });
    pixWrap.hidden = false;
  }

  function renderChecks(data) {
    if (!checksEl) return;
    const all = data.analise_tecnica || [];
    checksEl.innerHTML = "";
    for (const layer of CHECK_LAYERS) {
      const raw = pickKey(all, layer.key);
      const [status, detail] = layer.derive(raw, all);
      const li = document.createElement("li");
      li.dataset.status = status;
      li.innerHTML =
        `<span class="sl-check-num"></span>` +
        `<span class="sl-check-label"></span>` +
        `<span class="sl-check-detail"></span>`;
      li.querySelector(".sl-check-num").textContent = layer.num;
      li.querySelector(".sl-check-label").textContent = layer.label;
      li.querySelector(".sl-check-detail").textContent = detail;
      checksEl.appendChild(li);
    }
  }

  function render(data) {
    const codigo = data.codigo || "SEGURO";
    result.dataset.codigo = codigo;
    metaEl.textContent =
      `${data.dominio || data.url} · ${data.cache_hit ? "cache" : "análise nova"}` +
      (data.duracao_ms ? ` · ${(data.duracao_ms / 1000).toFixed(1)}s` : "");
    titleEl.textContent = data.titulo;
    subEl.textContent = data.subtitulo;

    if (typeof data.probabilidade === "number") {
      const pct = Math.round(data.probabilidade * 100);
      probWrap.hidden = false;
      probFill.style.width = pct + "%";
      probText.textContent = `probabilidade de fraude: ${pct}%`;
    } else {
      probWrap.hidden = true;
    }

    motivosEl.innerHTML = "";
    (data.motivos || []).forEach((m, i) => {
      const li = document.createElement("li");
      li.dataset.peso = m.peso || "info";
      li.innerHTML =
        `<span class="motivo-num">${String(i + 1).padStart(2, "0")}</span>` +
        `<div class="motivo-body"><h3></h3><p></p></div>`;
      li.querySelector("h3").textContent = m.titulo;
      li.querySelector("p").textContent = m.descricao;
      motivosEl.appendChild(li);
    });

    renderChecks(data);
    renderAcoes(data.acoes || []);
    renderPix(data.pix || null);

    if (data.analise_tecnica && data.analise_tecnica.length) {
      const lines = data.analise_tecnica.map((row) => {
        const k = row.chave.padEnd(26, " ");
        let v = row.valor;
        if (Array.isArray(v)) v = v.length ? v.join(", ") : "-";
        return `${k}: ${v}`;
      });
      techEl.textContent = lines.join("\n");
    } else {
      techEl.textContent = "-";
    }

    showPanel();
    result.hidden = false;
    softScroll();
  }

  // Renderiza resposta do /check-image (Pix + visão Grok + opcional url_check)
  function renderImage(data) {
    const codigo = data.veredito || "SEGURO";
    result.dataset.codigo = codigo;
    metaEl.textContent =
      `imagem · ${data.tipo_detectado || "outro"}` +
      (data.qr_codes_decodificados?.length ? ` · ${data.qr_codes_decodificados.length} QR` : "");
    const titMap = {
      SEGURO: "Nada de incomum nesta imagem",
      CAUTELA: "Verificar antes de pagar",
      RISCO: "Risco alto detectado na imagem",
    };
    titleEl.textContent = titMap[codigo] || titMap.CAUTELA;
    subEl.textContent = data.resumo || "Análise visual concluída.";

    const prob = typeof data.probabilidade_fraude === "number" ? data.probabilidade_fraude : null;
    if (prob != null) {
      const pct = Math.round(prob * 100);
      probWrap.hidden = false;
      probFill.style.width = pct + "%";
      probText.textContent = `probabilidade de fraude: ${pct}%`;
    } else {
      probWrap.hidden = true;
    }

    motivosEl.innerHTML = "";
    (data.indicios || []).forEach((m, i) => {
      const li = document.createElement("li");
      li.dataset.peso = "alto";
      li.innerHTML =
        `<span class="motivo-num">${String(i + 1).padStart(2, "0")}</span>` +
        `<div class="motivo-body"><h3></h3><p></p></div>`;
      li.querySelector("h3").textContent = "indício visual";
      li.querySelector("p").textContent = m;
      motivosEl.appendChild(li);
    });

    // Se houver url_check, mostra dele as checagens + ações
    const urlCheck = data.url_check || null;
    if (urlCheck) {
      renderChecks(urlCheck);
      renderAcoes(urlCheck.acoes || []);
      if (urlCheck.analise_tecnica?.length) {
        techEl.textContent = urlCheck.analise_tecnica
          .map((row) => `${row.chave.padEnd(26, " ")}: ${Array.isArray(row.valor) ? row.valor.join(", ") || "-" : row.valor}`)
          .join("\n");
      } else {
        techEl.textContent = "-";
      }
      const u = urlCheck.url || urlCheck.dominio;
      if (u) metaEl.textContent += ` · destino: ${u}`;
    } else {
      const checksEl2 = $("[data-checks]");
      if (checksEl2) checksEl2.innerHTML = "";
      renderAcoes([]);
      techEl.textContent = "-";
    }

    renderPix(data.pix);

    showPanel();
    result.hidden = false;
    softScroll();
  }

  function renderError(msg) {
    result.dataset.codigo = "ERRO";
    metaEl.textContent = "";
    titleEl.textContent = "Não foi possível verificar";
    subEl.textContent = msg;
    motivosEl.innerHTML = "";
    techEl.textContent = "";
    probWrap.hidden = true;
    showPanel();
    result.hidden = false;
    softScroll();
  }

  function normalizeApiErrorMessage(data, status) {
    if (status >= 500) return "Erro interno no servidor. Tente novamente em instantes.";
    const detail = data?.detail;
    if (typeof detail === "string" && detail.trim()) return detail;
    if (Array.isArray(detail) && detail.length) {
      const first = detail[0];
      if (typeof first === "string" && first.trim()) return first;
      if (first && typeof first === "object") {
        const msg = first.msg || first.message || first.type;
        if (typeof msg === "string" && msg.trim()) return msg;
      }
    }
    if (data && typeof data === "object") {
      const msg = data.message || data.error || data.title;
      if (typeof msg === "string" && msg.trim()) return msg;
    }
    return "Erro inesperado. Tente novamente.";
  }

  // --- Rate limit ----------------------------------------------------
  let _rateLimitTimer = null;
  function startRateLimitCountdown(seconds) {
    if (_rateLimitTimer) return;
    let remaining = seconds;
    function tick() {
      if (remaining <= 0) {
        clearInterval(_rateLimitTimer);
        _rateLimitTimer = null;
        setBusy(false);
        if (labelEl) labelEl.textContent = "verificar";
        submitBtn?.removeAttribute("data-ratelimit");
        return;
      }
      if (labelEl) labelEl.textContent = `aguarde ${remaining}s`;
      submitBtn?.setAttribute("data-ratelimit", remaining);
      remaining--;
    }
    tick();
    _rateLimitTimer = setInterval(tick, 1000);
  }
  function renderRateLimit(retryAfter) {
    const wait = parseInt(retryAfter, 10) || 60;
    result.dataset.codigo = "LIMITE";
    metaEl.textContent = "";
    titleEl.textContent = "Muitas verificações";
    subEl.innerHTML =
      `Você atingiu o limite gratuito. ` +
      `Aguarde ${wait} segundo${wait !== 1 ? "s" : ""} antes de verificar outro link. ` +
      `Para uso ilimitado, veja a <a href="/safelink/api">API profissional</a>.`;
    motivosEl.innerHTML = "";
    techEl.textContent = "";
    probWrap.hidden = true;
    showPanel();
    result.hidden = false;
    softScroll();
    startRateLimitCountdown(wait);
  }

  // --- Submit --------------------------------------------------------
  form?.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    if (_rateLimitTimer) return;

    // Modo IMAGEM
    if (pendingImage) {
      setBusy(true);
      showPanel();
      result.hidden = true;
      loaderStart();
      try {
        const fd = new FormData();
        fd.append("file", pendingImage);
        const r = await fetch(`${apiBase}/safelink/v1/public/check-image`, {
          method: "POST",
          body: fd,
        });
        setStepState("ai", "done");
        setStepState("consolidate", "active");
        const data = await r.json();
        await new Promise((res) => setTimeout(res, 200));
        loaderFinish();
        if (r.status === 429) {
          renderRateLimit(r.headers.get("Retry-After") || "60");
          return;
        }
        if (!r.ok) {
          renderError(normalizeApiErrorMessage(data, r.status));
          return;
        }
        renderImage(data);
      } catch (e) {
        loaderAbort();
        renderError("Não foi possível conectar à API. Tente novamente em instantes.");
      } finally {
        if (!_rateLimitTimer) setBusy(false);
      }
      return;
    }

    // Modo URL
    const raw = new FormData(form).get("url")?.toString() || "";
    const url = normalizeUserUrl(raw);
    if (!url) return;
    if (input && input.value !== url) input.value = url;

    setBusy(true);
    showPanel();
    result.hidden = true;
    loaderStart();

    try {
      const r = await fetch(`${apiBase}/safelink/v1/public/check`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url }),
      });
      setStepState("ai", "done");
      setStepState("consolidate", "active");
      const data = await r.json();
      await new Promise((res) => setTimeout(res, 200));
      loaderFinish();

      if (r.status === 429) {
        const retryAfter =
          r.headers.get("Retry-After") ||
          r.headers.get("X-RateLimit-Reset") ||
          "60";
        renderRateLimit(retryAfter);
        return;
      }
      if (!r.ok) {
        renderError(normalizeApiErrorMessage(data, r.status));
        return;
      }
      render(data);
    } catch (e) {
      loaderAbort();
      renderError("Não foi possível conectar à API. Tente novamente em instantes.");
    } finally {
      if (!_rateLimitTimer) setBusy(false);
    }
  });

  restart?.addEventListener("click", () => {
    result.hidden = true;
    panel.hidden = true;
    form?.reset();
    if (fileInput) fileInput.value = "";
    setPendingImage(null);
    input?.focus();
  });

  share?.addEventListener("click", async () => {
    const text = `${titleEl.textContent}. ${metaEl.textContent}`;
    if (navigator.share) {
      try { await navigator.share({ title: "Qantara SafeLink", text, url: location.href }); } catch {}
    } else if (navigator.clipboard) {
      await navigator.clipboard.writeText(`${text}\n${location.href}`);
      share.textContent = "copiado";
      setTimeout(() => (share.textContent = "compartilhar"), 1500);
    }
  });

  // --- Reportar como golpe ----------------------------------------
  let _lastDomain = null;
  function updateReportVisibility(data) {
    if (!reportBtn) return;
    // Permite reportar quando: análise foi de URL (não imagem sem destino)
    // E não é um veredito SEGURO já confirmado pela allowlist (evita ruído).
    const dom = data?.dominio || data?.url_check?.dominio || null;
    _lastDomain = dom;
    reportBtn.hidden = !dom;
    reportBtn.disabled = false;
    reportBtn.textContent = "reportar como golpe";
  }
  reportBtn?.addEventListener("click", async () => {
    if (!_lastDomain || reportBtn.disabled) return;
    const motivo = window.prompt(
      "Por que você considera isso golpe? (1=phishing, 2=boleto falso, 3=Pix falso, 4=loja fake, 5=outro)",
      "1"
    );
    if (!motivo) return;
    const map = { "1": "phishing", "2": "boleto_falso", "3": "pix_falso", "4": "loja_fake", "5": "outro" };
    const reason = map[motivo.trim()] || "phishing";
    reportBtn.disabled = true;
    reportBtn.textContent = "enviando…";
    try {
      const r = await fetch(`${apiBase}/safelink/v1/public/report`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: _lastDomain, motivo: reason }),
      });
      const data = await r.json();
      if (!r.ok) {
        reportBtn.textContent = data?.detail || "erro ao reportar";
        setTimeout(() => { reportBtn.textContent = "reportar como golpe"; reportBtn.disabled = false; }, 2500);
        return;
      }
      reportBtn.textContent = data.promovido_para_blocklist
        ? "✓ promovido p/ blocklist"
        : data.duplicado
        ? "✓ já reportado"
        : `✓ obrigado (${data.total_denuncias})`;
      // Atualiza stats
      loadStats();
    } catch (e) {
      reportBtn.textContent = "erro de rede";
      setTimeout(() => { reportBtn.textContent = "reportar como golpe"; reportBtn.disabled = false; }, 2500);
    }
  });

  // --- Estatísticas públicas --------------------------------------
  const statsSection = document.getElementById("sl-stats");
  const statsGrid = statsSection?.querySelector("[data-stats-grid]");
  const statsMeta = statsSection?.querySelector("[data-stats-meta]");
  const promptCount = document.getElementById("sl-prompt-count");
  function fmt(n) {
    if (n == null) return "0";
    if (n >= 1000000) return (n / 1000000).toFixed(1) + "M";
    if (n >= 1000) return (n / 1000).toFixed(1) + "k";
    return String(n);
  }
  async function loadStats() {
    if (!statsGrid) return;
    let s = null;
    try {
      const r = await fetch(`${apiBase}/safelink/v1/public/stats`, { cache: "no-store" });
      if (r.ok) s = await r.json();
    } catch {}
    s = s || { checks_total: 0, checks_risco: 0, checks_cautela: 0, checks_seguro: 0, reports_received: 0, reports_promoted: 0, avg_duration_ms: 0 };

    if (promptCount) {
      promptCount.textContent = s.checks_total > 0
        ? `${fmt(s.checks_total)} verificacoes`
        : "online";
    }

    // Stats só aparecem com volume honesto (>=50 checagens).
    // Abaixo disso, melhor não mostrar do que mostrar números pequenos.
    const SHOW_THRESHOLD = 50;
    if (s.checks_total < SHOW_THRESHOLD) {
      if (statsSection) statsSection.hidden = true;
      return;
    }

    if (statsSection) statsSection.hidden = false;
    if (statsMeta) statsMeta.textContent = `${fmt(s.checks_total)} verificacoes`;
    statsGrid.innerHTML = "";
    const dash = "—";
    const pct = (part, total) => total > 0 ? Math.round((part / total) * 100) + "%" : dash;
    const tiles = [
      ["verificacoes totais", fmt(s.checks_total)],
      ["golpes detectados", pct(s.checks_risco, s.checks_total)],
      ["alertas (cautela)", pct(s.checks_cautela, s.checks_total)],
      ["denuncias recebidas", fmt(s.reports_received)],
      ["promovidas p/ blocklist", fmt(s.reports_promoted)],
      ["tempo medio", s.avg_duration_ms ? (s.avg_duration_ms / 1000).toFixed(1) + "s" : dash],
    ];
    for (const [label, value] of tiles) {
      const tile = document.createElement("div");
      tile.className = "sl-stat-tile";
      tile.innerHTML = `<b></b><span></span>`;
      tile.querySelector("b").textContent = value;
      tile.querySelector("span").textContent = label;
      statsGrid.appendChild(tile);
    }
  }
  loadStats();

  // Hook em render() / renderImage() para mostrar/esconder o botão report.
  // Patcheamos as funções existentes preservando o comportamento.
  const _origRender = render;
  render = function (data) {
    _origRender(data);
    updateReportVisibility(data);
  };
  const _origRenderImage = renderImage;
  renderImage = function (data) {
    _origRenderImage(data);
    updateReportVisibility(data);
  };
</script>

<style>
  /* ============================================================
     SafeLink — tema 100% claro, layout enxuto.
     Não depende de variáveis dark do site. Usa um sistema próprio.
     ============================================================ */

  .sl {
    /* Tokens locais light, isolados do resto do site */
    --sl-bg: #ffffff;
    --sl-surface: #f6f7f8;
    --sl-border: #e3e6ea;
    --sl-fg: #14181c;
    --sl-fg-muted: #586069;
    --sl-fg-soft: #8a929c;
    --sl-accent: #0f766e;       /* teal escuro, alto contraste no claro */
    --sl-accent-soft: #d6f0ec;
    --sl-danger: #b42318;
    --sl-warn: #b45309;
    --sl-ok: #0f766e;
    --sl-mono: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Consolas, monospace;

    background: var(--sl-bg);
    color: var(--sl-fg);
    min-height: 100svh;
  }

  .sl .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* Topo: hero compacto, sem imagem, sem efeitos pesados ----------- */
  .sl-top {
    padding: 5rem 0 2.75rem;
    border-bottom: 1px solid var(--sl-border);
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 0%,
        var(--sl-accent-soft) 0%,
        transparent 70%
      );
  }
  .sl-wrap {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .sl-head { margin-bottom: 1.6rem; }

  /* Terminal-style kicker — mesmo idioma do hero institucional ----- */
  .sl-prompt {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--sl-fg-soft);
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--sl-border);
    border-radius: 999px;
    background: var(--sl-bg);
    margin: 0 0 1.4rem 0;
    line-height: 1;
  }
  .sl-prompt-sigil { color: var(--sl-fg-muted); }
  .sl-prompt-dollar { color: var(--sl-accent); font-weight: 600; }
  .sl-prompt-cmd { color: var(--sl-fg); font-weight: 500; }
  .sl-prompt-flag { color: var(--sl-fg-soft); }
  .sl-prompt-val { color: var(--sl-accent); font-weight: 500; }
  .sl-prompt-caret {
    display: inline-block;
    width: 6px;
    height: 12px;
    background: var(--sl-accent);
    margin-left: 0.1rem;
    animation: sl-blink 1.1s steps(2) infinite;
  }
  @keyframes sl-blink { 50% { opacity: 0; } }

  .sl-title {
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 600;
    margin: 0 0 0.95rem 0;
    color: var(--sl-fg);
  }
  .sl-title em {
    font-style: normal;
    color: var(--sl-accent);
  }
  .sl-break { display: none; }
  @media (min-width: 720px) { .sl-break { display: inline; } }

  .sl-lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--sl-fg-muted);
    margin: 0 auto;
    max-width: 38rem;
  }
  .sl-lede strong { color: var(--sl-fg); font-weight: 600; }
  .sl-lede em { font-style: normal; color: var(--sl-fg); font-weight: 500; border-bottom: 1px solid var(--sl-accent-soft); }

  /* Form ----------------------------------------------------------- */
  .sl-form {
    display: flex;
    gap: 0.5rem;
    border: 1px solid var(--sl-border);
    background: var(--sl-bg);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .sl-form:focus-within {
    border-color: var(--sl-accent);
    box-shadow: 0 0 0 3px var(--sl-accent-soft);
  }
  .sl-form input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--sl-fg);
    font: inherit;
    font-size: 1rem;
    padding: 0.95rem 1.1rem;
    min-width: 0;
  }
  .sl-form input::placeholder {
    color: var(--sl-fg-soft);
    font-family: var(--sl-mono);
    font-size: 0.92rem;
  }
  .sl-submit {
    display: inline-flex;
    align-items: center;
    padding: 0 1.5rem;
    background: var(--sl-accent);
    color: #fff;
    border: 0;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .sl-submit:hover { background: #115e59; }
  .sl-submit:disabled { opacity: 0.7; cursor: progress; }
  .sl-submit[data-ratelimit] {
    cursor: not-allowed;
    background: #c2410c;
    opacity: 0.85;
  }

  .sl-meta {
    margin: 0.85rem auto 0;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--sl-fg-soft);
    text-align: center;
  }
  .sl-meta code {
    background: var(--sl-surface);
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    font-size: 0.75rem;
    color: var(--sl-fg-muted);
  }

  @media (max-width: 600px) {
    .sl-form { flex-direction: column; border-radius: 8px; }
    .sl-submit { padding: 0.95rem; justify-content: center; }
  }

  /* Anexar imagem ----------------------------------------------- */
  .sl-attach {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    background: transparent;
    color: var(--sl-fg-muted);
    border: 0;
    border-left: 1px solid var(--sl-border);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .sl-attach:hover { color: var(--sl-accent); background: var(--sl-surface); }
  .sl-form[data-dragover="1"] {
    outline: 2px dashed var(--sl-accent);
    outline-offset: 4px;
    background: var(--sl-accent-soft);
  }
  .sl-attach-preview {
    margin: 0.6rem auto 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.7rem;
    background: var(--sl-accent-soft);
    border: 1px solid var(--sl-accent);
    border-radius: 999px;
    font-family: var(--sl-mono);
    font-size: 0.8rem;
    color: var(--sl-accent);
  }
  .sl-attach-preview button {
    background: transparent;
    border: 0;
    color: var(--sl-danger);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
  }

  /* Pix detectado ------------------------------------------------ */
  :global(.sl-pix) {
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    background: var(--sl-accent-soft);
    border: 1px solid var(--sl-accent);
    border-radius: 6px;
  }
  :global(.sl-pix-grid) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1rem;
    margin: 0.5rem 0 0.6rem;
    font-size: 0.92rem;
  }
  :global(.sl-pix-grid dt) {
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-muted);
    text-transform: lowercase;
  }
  :global(.sl-pix-grid dd) {
    margin: 0;
    color: var(--sl-fg);
    font-weight: 500;
  }
  :global(.sl-pix-warn) {
    margin: 0;
    font-size: 0.88rem;
    color: var(--sl-fg-muted);
  }

  /* Ações pós-veredito ------------------------------------------- */
  :global(.sl-acoes) { margin-top: 1.4rem; }
  :global(.sl-acoes-list) {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  :global(.sl-acao) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    background: var(--sl-surface);
    border: 1px solid var(--sl-border);
    border-radius: 6px;
  }
  :global(.sl-acao h4) {
    margin: 0 0 0.1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--sl-fg);
  }
  :global(.sl-acao p) {
    margin: 0;
    font-size: 0.84rem;
    color: var(--sl-fg-muted);
  }
  :global(.sl-acao a) {
    flex-shrink: 0;
    padding: 0.4rem 0.85rem;
    background: var(--sl-fg);
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
  }
  :global(.sl-acao a:hover) { background: var(--sl-accent); }

  /* Painel: loader + resultado dentro do mesmo bloco --------------- */
  .sl-panel {
    margin-top: 1.75rem;
    border: 1px solid var(--sl-border);
    border-radius: 10px;
    background: var(--sl-bg);
    overflow: hidden;
    text-align: left;
    box-shadow: 0 4px 24px -12px rgba(15, 23, 42, 0.12);
  }
  .sl-panel[hidden] { display: none; }

  /* Loader compacto ------------------------------------------------ */
  .sl-loader { padding: 1.1rem 1.25rem; }
  .sl-loader[hidden] { display: none; }
  .sl-loader-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--sl-mono);
    font-size: 0.82rem;
    color: var(--sl-fg-muted);
    margin-bottom: 0.85rem;
  }
  .sl-spinner {
    width: 13px; height: 13px;
    border-radius: 50%;
    border: 2px solid var(--sl-accent-soft);
    border-top-color: var(--sl-accent);
    animation: sl-spin 0.9s linear infinite;
    flex-shrink: 0;
  }
  @keyframes sl-spin { to { transform: rotate(360deg); } }
  .sl-elapsed {
    margin-left: auto;
    color: var(--sl-fg-soft);
    font-variant-numeric: tabular-nums;
  }
  .sl-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.92rem;
    color: var(--sl-fg-soft);
  }
  .sl-steps li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 200ms ease;
  }
  .sl-steps li > span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #d8dde2;
    flex-shrink: 0;
    transition: background 200ms ease, box-shadow 200ms ease;
  }
  .sl-steps li[data-state="active"] { color: var(--sl-fg); }
  .sl-steps li[data-state="active"] > span {
    background: var(--sl-accent);
    box-shadow: 0 0 0 4px var(--sl-accent-soft);
    animation: sl-pulse 1s ease-in-out infinite;
  }
  .sl-steps li[data-state="done"] { color: var(--sl-fg-muted); }
  .sl-steps li[data-state="done"] > span { background: var(--sl-accent); }
  @keyframes sl-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sl-spinner, .sl-steps li[data-state="active"] > span { animation: none; }
  }

  /* Resultado ------------------------------------------------------ */
  .sl-result {
    padding: 1.5rem 1.5rem 1.75rem;
    border-top: 1px solid var(--sl-border);
  }
  .sl-result[hidden] { display: none; }
  .sl-loader[hidden] + .sl-result { border-top: 0; }

  .sl-result-meta {
    margin: 0 0 0.6rem 0;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-soft);
    word-break: break-all;
  }
  .sl-result-title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-weight: 600;
    margin: 0 0 0.4rem 0;
    color: var(--sl-fg);
  }
  .sl-result-subtitle {
    margin: 0 0 1.25rem 0;
    color: var(--sl-fg-muted);
    font-size: 1rem;
    line-height: 1.55;
  }
  .sl-result-subtitle a {
    color: var(--sl-accent);
    text-underline-offset: 3px;
  }

  /* cores por veredito */
  .sl-result[data-codigo="RISCO"]   .sl-result-title { color: var(--sl-danger); }
  .sl-result[data-codigo="CAUTELA"] .sl-result-title { color: var(--sl-warn); }
  .sl-result[data-codigo="SEGURO"]  .sl-result-title { color: var(--sl-ok); }
  .sl-result[data-codigo="LIMITE"]  .sl-result-title { color: var(--sl-warn); }

  /* Probabilidade -------------------------------------------------- */
  .sl-prob { margin: 0 0 1.5rem 0; max-width: 28rem; }
  .sl-prob[hidden] { display: none; }
  .sl-prob-bar {
    height: 4px;
    background: var(--sl-surface);
    overflow: hidden;
    border-radius: 2px;
  }
  .sl-prob-fill {
    height: 100%;
    background: var(--sl-accent);
    transition: width 500ms ease;
  }
  .sl-result[data-codigo="RISCO"] .sl-prob-fill   { background: var(--sl-danger); }
  .sl-result[data-codigo="CAUTELA"] .sl-prob-fill { background: var(--sl-warn); }
  .sl-prob-text {
    margin: 0.45rem 0 0 0;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-soft);
  }

  /* Motivos -------------------------------------------------------- */
  .sl-motivos {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sl-motivos :global(li) {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--sl-border);
    border-left-width: 3px;
    border-radius: 6px;
    background: var(--sl-bg);
  }
  .sl-motivos :global(li[data-peso="alto"])  { border-left-color: var(--sl-danger); }
  .sl-motivos :global(li[data-peso="medio"]) { border-left-color: var(--sl-warn); }
  .sl-motivos :global(li[data-peso="info"])  { border-left-color: var(--sl-accent); }
  :global(.motivo-num) {
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-soft);
    padding-top: 0.15rem;
  }
  :global(.motivo-body h3) {
    margin: 0 0 0.25rem 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sl-fg);
  }
  :global(.motivo-body p) {
    margin: 0;
    color: var(--sl-fg-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* Bloco técnico -------------------------------------------------- */
  .sl-tech {
    margin-bottom: 1.25rem;
    border-top: 1px solid var(--sl-border);
    padding-top: 1rem;
  }
  .sl-tech summary {
    cursor: pointer;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-muted);
    list-style: none;
    user-select: none;
  }
  .sl-tech summary::before {
    content: "▸ ";
    transition: transform 150ms;
  }
  .sl-tech[open] summary::before { content: "▾ "; }
  .sl-tech pre {
    margin-top: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--sl-surface);
    border: 1px solid var(--sl-border);
    border-radius: 6px;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--sl-fg);
    overflow-x: auto;
    white-space: pre;
  }

  /* Ações ---------------------------------------------------------- */
  .sl-warning {
    margin: 1.25rem 0 1.5rem;
    padding: 1.1rem 1.25rem 1.2rem;
    background: #fff8ec;
    border: 1px solid color-mix(in oklch, var(--sl-warn) 35%, transparent);
    border-left: 4px solid var(--sl-warn);
    border-radius: 8px;
    color: var(--sl-fg);
  }
  .sl-warning-kicker {
    margin: 0 0 0.45rem 0;
    font-family: var(--sl-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-warn);
  }
  .sl-warning-headline {
    margin: 0 0 0.65rem 0;
    font-size: 1.02rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--sl-fg);
  }
  .sl-warning-body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-fg-muted);
  }
  .sl-warning-body b { color: var(--sl-fg); font-weight: 600; }

  .sl-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .sl-action {
    background: transparent;
    border: 1px solid var(--sl-border);
    color: var(--sl-fg);
    padding: 0.55rem 1rem;
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    border-radius: 6px;
    transition: border-color 150ms, background-color 150ms;
  }
  .sl-action:hover {
    border-color: var(--sl-accent);
    background: var(--sl-accent-soft);
  }

  /* Checagens (12 camadas no resultado) ---------------------------- */
  .sl-checks {
    margin: 0 0 1.5rem 0;
    padding: 1rem 0 0 0;
    border-top: 1px solid var(--sl-border);
  }
  .sl-checks-title {
    margin: 0 0 0.85rem 0;
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--sl-fg-soft);
    text-transform: lowercase;
    font-weight: 500;
  }
  .sl-checks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--sl-border);
    border-radius: 6px;
    background: var(--sl-bg);
    overflow: hidden;
  }
  .sl-checks-list :global(li) {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--sl-border);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .sl-checks-list :global(li:last-child) { border-bottom: 0; }
  :global(.sl-check-num) {
    font-family: var(--sl-mono);
    font-size: 0.75rem;
    color: var(--sl-fg-soft);
    letter-spacing: 0.02em;
  }
  :global(.sl-check-label) { color: var(--sl-fg); }
  :global(.sl-check-detail) {
    font-family: var(--sl-mono);
    font-size: 0.78rem;
    color: var(--sl-fg-muted);
    text-align: right;
    padding-left: 0.5rem;
    border-left: 3px solid var(--sl-border);
  }
  .sl-checks-list :global(li[data-status="ok"]     .sl-check-detail) { border-left-color: var(--sl-ok); color: var(--sl-ok); }
  .sl-checks-list :global(li[data-status="alerta"] .sl-check-detail) { border-left-color: var(--sl-danger); color: var(--sl-danger); }
  .sl-checks-list :global(li[data-status="info"]   .sl-check-detail) { border-left-color: var(--sl-accent); }
  .sl-checks-list :global(li[data-status="na"]     .sl-check-detail) { border-left-color: var(--sl-border); color: var(--sl-fg-soft); }
  @media (max-width: 520px) {
    .sl-checks-list :global(li) {
      grid-template-columns: 2rem 1fr;
      grid-template-rows: auto auto;
    }
    :global(.sl-check-detail) {
      grid-column: 2;
      text-align: left;
      border-left: 0;
      padding-left: 0;
      padding-top: 0.15rem;
    }
  }

  /* === SHARED LANDING PRIMITIVES (institutional style) ============ */

  /* Eyebrow horizontal: [label] [meta]. Sem traço decorativo. */
  .sl-eyebrow-row,
  .sl-stats-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin: 0 0 1.4rem 0;
    font-family: var(--sl-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    line-height: 1;
    min-width: 0;
  }
  .sl-eyebrow-text {
    flex-shrink: 0;
    color: var(--sl-accent);
    font-weight: 500;
  }
  .sl-eyebrow-meta {
    color: var(--sl-fg-soft);
    flex-shrink: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 520px) {
    .sl-eyebrow-row, .sl-stats-head { gap: 0.65rem; }
  }

  /* Section title (display-style, com `<em>` accent) ---------------- */
  .sl-section-title {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 0.85rem 0;
    color: var(--sl-fg);
  }
  .sl-section-title em {
    font-style: normal;
    color: var(--sl-accent);
  }
  .sl-section-lede {
    margin: 0;
    color: var(--sl-fg-muted);
    font-size: 0.96rem;
    line-height: 1.6;
    max-width: 32ch;
  }
  .sl-section-lede em {
    font-style: normal;
    color: var(--sl-fg);
    border-bottom: 1px solid var(--sl-accent-soft);
  }

  /* Numero monoespaçado reutilizado (timeline + lista 12) ----------- */
  .sl-num {
    font-family: var(--sl-mono);
    font-size: 0.72rem;
    color: var(--sl-fg-soft);
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  /* Grid 12-col com aside sticky (idêntico ao Method institucional) */
  .sl-grid12 {
    max-width: 72rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 880px) {
    .sl-grid12 {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
    }
  }
  .sl-grid12-aside {
    align-self: start;
  }
  @media (min-width: 880px) {
    .sl-grid12-aside { position: sticky; top: 6rem; }
  }

  /* === STATS — minimalistas, sem caixinhas ========================= */
  .sl-stats {
    padding: 2.5rem 0 0.5rem;
    border-top: 1px solid var(--sl-border);
  }
  .sl-stats .u-container { max-width: 64rem; }
  .sl-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0;
    border-top: 1px solid var(--sl-border);
  }
  .sl-stat-tile {
    padding: 1rem 1.1rem;
    border-right: 1px solid var(--sl-border);
    border-bottom: 1px solid var(--sl-border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: transparent;
  }
  .sl-stat-tile:last-child { border-right: 0; }
  .sl-stat-tile b {
    font-family: var(--sl-mono);
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--sl-fg);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .sl-stat-tile span {
    font-size: 0.76rem;
    color: var(--sl-fg-soft);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }
  .sl-stats-foot {
    margin: 1rem 0 0;
    font-family: var(--sl-mono);
    font-size: 0.72rem;
    color: var(--sl-fg-soft);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }
  .sl-stats-foot a {
    color: var(--sl-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .sl-stats-foot a:hover { color: var(--sl-fg); }

  /* === HOWTO — timeline vertical com nodes (Method.astro style) === */
  .sl-howto { padding: 4rem 0 4.5rem; }
  .sl-timeline {
    position: relative;
    padding-left: 1.85rem;
    list-style: none;
    margin: 0;
  }
  .sl-timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklch, var(--sl-accent) 55%, transparent) 12%,
      color-mix(in oklch, var(--sl-accent) 22%, transparent) 88%,
      transparent
    );
  }
  .sl-timeline-step {
    position: relative;
    padding-bottom: 2.2rem;
  }
  .sl-timeline-step:last-child { padding-bottom: 0; }
  .sl-timeline-node {
    position: absolute;
    left: -1.85rem;
    top: 9px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklch, var(--sl-accent) 65%, transparent);
    background: var(--sl-bg);
    transition: box-shadow 320ms ease, background 240ms ease;
  }
  .sl-timeline-step:hover .sl-timeline-node {
    background: var(--sl-accent);
    box-shadow: 0 0 16px color-mix(in oklch, var(--sl-accent) 55%, transparent);
  }
  .sl-timeline-content { display: grid; gap: 0.45rem; }
  .sl-timeline-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .sl-timeline-head h3 {
    margin: 0;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--sl-fg);
    line-height: 1.25;
  }
  .sl-timeline-content p {
    margin: 0;
    color: var(--sl-fg-muted);
    font-size: 0.94rem;
    line-height: 1.6;
    max-width: 52ch;
  }
  .sl-timeline-content em { font-style: normal; color: var(--sl-fg); font-weight: 500; }

  /* === CAMADAS — lista com divisórias (Services.astro style) ====== */
  .sl-camadas {
    padding: 4rem 0 4.5rem;
