---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
---

<Base title="Página não encontrada · Qantara" noindex minimalHeader>
  <main id="conteudo" class="notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">Essa página não <em>existe</em>.</h1>
    <p class="notfound__lede">
      O endereço pode estar errado ou a página foi movida.
    </p>
    <div class="notfound__actions">
      <Button href="/">voltar ao início</Button>
      <Button href="/safelink/" variant="ghost">ir para o SafeLink</Button>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 6rem 1.5rem 4rem;
    max-width: 48rem;
    margin: 0 auto;
  }
  .notfound__code {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    opacity: 0.6;
    letter-spacing: 0.08em;
  }
  .notfound__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    font-weight: 600;
    margin: 0;
  }
  .notfound__title em {
    font-style: italic;
    opacity: 0.8;
  }
  .notfound__lede {
    font-size: 1.1rem;
    opacity: 0.8;
    max-width: 36rem;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
