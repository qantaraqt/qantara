---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import { faqs, site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  minimalHeader?: boolean;
  noindex?: boolean;
  forceTheme?: "light" | "dark";
}

const {
  title = "Qantara · consultoria especializada em engenharia de software",
  description = "Consultoria especializada em engenharia de software. Sistemas web, segurança, infraestrutura e antifraude, construídos à mão, do primeiro escopo ao deploy em produção.",
  minimalHeader = false,
  noindex = false,
  forceTheme,
} = Astro.props;

const canonical = "https://qantara.com.br";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonical}/#org`,
      name: site.brand,
      url: canonical,
      logo: `${canonical}/logo-og.jpg`,
      slogan: site.tagline,
      areaServed: "Worldwide",
      sameAs: [site.linkedin],
      contactPoint: [{
        "@type": "ContactPoint",
        contactType: "sales",
        url: site.linkedin,
        availableLanguage: ["pt-BR", "es", "en"],
      }],
    },
    {
      "@type": "WebSite",
      "@id": `${canonical}/#site`,
      url: canonical,
      name: site.brand,
      inLanguage: "pt-BR",
      publisher: { "@id": `${canonical}/#org` },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1518" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Performance hints -->
    <link rel="preload" as="image" href="/back.avif" type="image/avif" fetchpriority="high" />
    <link rel="preconnect" href="https://cdn.simpleicons.org" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />

    <!-- Theme bootstrap — set data-theme before paint to avoid FOUC -->
    {forceTheme ? (
      <script is:inline define:vars={{ forceTheme }}>
        document.documentElement.setAttribute("data-theme", forceTheme);
      </script>
    ) : (
      <script is:inline>
        (function () {
          try {
            var saved = localStorage.getItem("theme");
            var theme = saved === "dark" || saved === "light" ? saved : "dark";
            document.documentElement.setAttribute("data-theme", theme);
          } catch (_) {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        })();
      </script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Qantara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content="https://qantara.com.br/logo-og.jpg?v=2" />
    <meta property="og:image:secure_url" content="https://qantara.com.br/logo-og.jpg?v=2" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Qantara, consultoria especializada em engenharia de software" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://qantara.com.br/logo-og.jpg?v=2" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">saltar para o conteúdo</a>
    <div class="ambient" aria-hidden="true"></div>
    <div class="ambient-grain" aria-hidden="true"></div>

    <!-- hero-human-bar removed as requested -->
    <Header minimal={minimalHeader} />
    <slot />
    <ThemeToggle />

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -100px;
        z-index: 100;
        background: var(--color-teal);
        color: var(--color-ink-deep);
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        transition: top 200ms ease;
      }
      .skip-link:focus { top: 1rem; }

      .hero-human-bar {
        width: 100%;
        background: linear-gradient(90deg, color-mix(in oklch, var(--color-teal) 12%, transparent) 0%, transparent 100%);
        color: var(--fg);
        padding: 0.65rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 1.08rem;
        letter-spacing: 0.01em;
        font-weight: 500;
        border-bottom: 1px solid color-mix(in oklch, var(--color-teal) 10%, transparent);
        box-shadow: 0 2px 12px -8px color-mix(in oklch, var(--color-teal) 10%, transparent);
        z-index: 50;
        position: relative;
      }
      .hero-human-msg {
        color: color-mix(in oklch, var(--color-teal) 80%, var(--fg) 20%);
        text-shadow: 0 1px 8px color-mix(in oklch, var(--color-teal) 18%, transparent);
      }
      @media (max-width: 600px) {
        .hero-human-bar { font-size: 0.98rem; padding: 0.5rem 0; }
      }
    </style>
  </body>
</html>
