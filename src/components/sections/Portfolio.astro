---
// Puedes reemplazar estos datos con tus propios proyectos
const projects = [
  {
    title: "Proyecto 1",
    image: "/bridge.avif",
    link: "#"
  },
  {
    title: "Proyecto 2",
    image: "/bridge.avif",
    link: "#"
  },
  {
    title: "Proyecto 3",
    image: "/bridge.avif",
    link: "#"
  }
];
---
<section class="portfolio-section">
  <h2>Portafolio</h2>
  <div class="portfolio-grid">
    {projects.map(project => (
      <a href={project.link} class="portfolio-card" target="_blank">
        <img src={project.image} alt={project.title} class="portfolio-image" />
        <h3>{project.title}</h3>
      </a>
    ))}
  </div>
</section>

<style>
.portfolio-section {
  padding: 4rem 0;
  background: var(--color-bg, #fff);
}
.portfolio-section h2 {
  text-align: center;
  margin-bottom: 2rem;
}
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}
.portfolio-card {
  background: #f9f9f9;
  border-radius: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  text-decoration: none;
  color: inherit;
  padding: 1.5rem;
  transition: transform 0.2s, box-shadow 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.portfolio-card:hover {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 6px 24px rgba(0,0,0,0.12);
}
.portfolio-image {
  width: 100%;
  max-width: 220px;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}
.portfolio-card h3 {
  margin: 0.5rem 0 0.25rem 0;
}
.portfolio-card p {
  font-size: 0.98rem;
  color: #555;
  text-align: center;
}
</style>
