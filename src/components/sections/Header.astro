---
import { site, nav } from "../../content/site";
---

<header class="site-header fixed top-0 inset-x-0 z-40">
  <div class="deck-line" aria-hidden="true"></div>

  <div class="u-container flex items-center justify-between py-4 md:py-5">
    <a href="/" class="flex items-center gap-2 group brand" aria-label={site.brand}>
      <svg
        viewBox="0 0 28 32"
        class="brand-mark w-[16px] h-[18px]"
        aria-hidden="true"
      >
        <path
          d="M6 2 L22 2 L26 6 L26 22 L22 26 L6 26 L2 22 L2 6 Z"
          fill="none"
          stroke="var(--color-teal)"
          stroke-width="3"
          stroke-linejoin="miter"
        />
        <line
          x1="20" y1="20"
          x2="27" y2="30"
          stroke="var(--color-teal)"
          stroke-width="3.25"
          stroke-linecap="square"
        />
      </svg>
      <span class="mono text-sm text-white/80 group-hover:text-white transition-colors">
        {site.brand}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="mono text-xs text-white/55 hover:text-white transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`mailto:${site.email}?subject=Projeto%20qantara`}
        class="mono text-xs text-[var(--color-teal)] hover:text-white transition-colors"
      >
        iniciar conversa ↗
      </a>
    </nav>

    <a
      href={`mailto:${site.email}?subject=Projeto%20qantara`}
      class="md:hidden mono text-[0.7rem] text-[var(--color-teal)] hover:text-white transition-colors"
    >
      iniciar conversa ↗
    </a>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in oklch, var(--color-ink-deep) 72%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid color-mix(in oklch, white 4%, transparent);
  }

  .brand-mark {
    filter: drop-shadow(0 0 6px color-mix(in oklch, var(--color-teal) 30%, transparent));
    animation: brand-pulse 3.6s ease-in-out infinite;
    transition: filter 400ms ease;
  }
  .brand:hover .brand-mark {
    filter: drop-shadow(0 0 14px color-mix(in oklch, var(--color-teal) 80%, transparent))
            drop-shadow(0 0 24px color-mix(in oklch, var(--color-teal) 35%, transparent));
    animation-play-state: paused;
  }

  @keyframes brand-pulse {
    0%, 100% {
      filter: drop-shadow(0 0 4px color-mix(in oklch, var(--color-teal) 20%, transparent));
    }
    50% {
      filter: drop-shadow(0 0 12px color-mix(in oklch, var(--color-teal) 60%, transparent))
              drop-shadow(0 0 18px color-mix(in oklch, var(--color-teal) 25%, transparent));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark { animation: none; }
  }
</style>
