---
import SectionHeader from "../ui/SectionHeader.astro";
import Disclosure from "../ui/Disclosure.astro";
import { services, wa, waMessages } from "../../content/site";
---

<section id="servicos" class="section-vault py-20 md:py-28 relative">
  <div class="u-container">
    <SectionHeader eyebrow="serviços" meta={`0${services.length} áreas`}>
      O que construímos.
    </SectionHeader>

    <ul class="services-list">
      {services.map((s, i) => (
        <li>
          <Disclosure name="services" open={i === 0} class="service">
            <div slot="summary" class="service-row">
              <span class="mono text-xs text-white/35 service-num">{s.num}</span>
              <span class="display text-[clamp(1.5rem,4vw,2.75rem)] leading-tight service-title">
                {s.title}
              </span>
              <span class="service-chevron" aria-hidden="true">
                <svg viewBox="0 0 16 16" class="w-full h-full">
                  <path d="M3 8 L13 8 M8 3 L8 13" stroke="currentColor" stroke-width="1" fill="none" />
                </svg>
              </span>
            </div>
            <div class="service-body">
              <p class="text-white/70 max-w-[58ch]">{s.lede}</p>
              <ul class="service-entregas">
                {s.entregas.map((e) => (
                  <li>
                    <span class="u-dot"></span>
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
              <div class="service-stack-row">
                <ul class="service-stack-logos" aria-label="Tecnologias">
                  {s.stackLogos.map((t) => (
                    <li title={t.name}>
                      <img
                        src={`https://cdn.simpleicons.org/${t.slug}`}
                        alt={t.name}
                        width="20"
                        height="20"
                        loading="lazy"
                        decoding="async"
                        class:list={["service-stack-logo", { "service-stack-logo--mono": t.mono }]}
                      />
                      <span class="mono">{t.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <a
                href={wa(waMessages.service(s.title))}
                target="_blank"
                rel="noopener noreferrer"
                class="service-cta mono"
              >
                conversar sobre {s.title.toLowerCase()} →
              </a>
            </div>
          </Disclosure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-list > li {
    border-top: 1px solid color-mix(in oklch, var(--fg) 7%, transparent);
  }
  .services-list > li:last-child {
    border-bottom: 1px solid color-mix(in oklch, var(--fg) 7%, transparent);
  }

  .service {
    position: relative;
    padding: 0.9rem 0;
    transition: background 400ms var(--ease-emph);
  }
  .service[open] {
    background: linear-gradient(
      90deg,
      color-mix(in oklch, var(--color-teal) 4%, transparent),
      transparent 55%
    );
  }

  .service-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 0.35rem 0;
  }
  .service-num {
    letter-spacing: 0.18em;
    font-size: 0.65rem;
    color: color-mix(in oklch, var(--color-teal) 55%, transparent);
  }
  .service-title {
    color: color-mix(in oklch, var(--fg) 85%, transparent);
    transition: color 300ms var(--ease-emph);
    font-size: clamp(1.15rem, 2.4vw, 1.8rem) !important;
    letter-spacing: -0.02em;
  }
  .service[open] .service-title,
  .service:hover .service-title {
    color: white;
  }

  .service-chevron {
    width: 14px;
    height: 14px;
    color: color-mix(in oklch, var(--fg) 40%, transparent);
    transition: transform 360ms var(--ease-emph), color 300ms ease;
  }
  .service[open] .service-chevron {
    transform: rotate(45deg);
    color: var(--color-teal);
  }

  .service-body {
    padding: 0.85rem 0 0.25rem 2.5rem;
    display: grid;
    gap: 0.9rem;
  }
  .service-body > p {
    font-size: 0.9rem;
    color: color-mix(in oklch, var(--fg) 65%, transparent);
  }
  .service-entregas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
  }
  .service-entregas li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: color-mix(in oklch, var(--fg) 70%, transparent);
    font-size: 0.85rem;
  }
  .service-stack {
    padding-top: 0.5rem;
    border-top: 1px dashed color-mix(in oklch, var(--fg) 8%, transparent);
    font-size: 0.6rem !important;
    letter-spacing: 0.22em;
  }

  .service-stack-row {
    padding-top: 0.6rem;
    border-top: 1px dashed color-mix(in oklch, var(--fg) 10%, transparent);
  }
  .service-stack-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  .service-stack-logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--fg) 55%, transparent);
    transition: color 300ms ease;
  }
  .service-stack-logos li:hover {
    color: color-mix(in oklch, var(--fg) 90%, transparent);
  }
  .service-stack-logo {
    width: 18px;
    height: 18px;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 300ms ease, transform 400ms var(--ease-emph);
  }
  .service-stack-logos li:hover .service-stack-logo {
    opacity: 1;
    transform: scale(1.1);
  }
  /* Services section is always vault/dark, so mono logos must invert. */
  .service-stack-logo--mono {
    filter: invert(1) brightness(1.1);
  }

  @media (max-width: 640px) {
    .service-body { padding-left: 0; }
    .service-entregas { grid-template-columns: 1fr; }
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-teal) 75%, transparent);
    border-bottom: 1px dashed color-mix(in oklch, var(--color-teal) 35%, transparent);
    padding-bottom: 2px;
    width: fit-content;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .service-cta:hover {
    color: var(--color-teal);
    border-color: color-mix(in oklch, var(--color-teal) 70%, transparent);
  }
</style>
