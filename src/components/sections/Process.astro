---
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import { process, site } from "../../content/site";
---

<section id="comecar" class="section-vault process-section py-20 md:py-28">
  <div class="u-container">
    <SectionHeader eyebrow="começar" meta={`0${process.length} passos`}>
      Como a gente começa.
    </SectionHeader>

    <p class="process-lede">
      Quatro passos para descobrir, em mais ou menos uma semana, se faz
      sentido trabalharmos juntos. Nenhum deles é uma reunião de vendas.
    </p>

    <ol class="process-grid">
      {process.map((s, i) => (
        <li class:list={["process-card", { "process-card--accent": i === process.length - 1 }]}>
          <span class="process-ghost" aria-hidden="true">{s.num}</span>
          <div class="process-card-head">
            <span class="mono process-num">{s.num}</span>
            <h3 class="display process-title">{s.title}</h3>
          </div>
          <p class="process-desc">{s.desc}</p>
          <span class="mono process-meta">{s.meta}</span>
        </li>
      ))}
    </ol>

    <div class="process-cta">
      <Button href={site.linkedin} variant="primary" external={true}>
        Agendar conversa
      </Button>
      <span class="mono process-cta-meta">resposta em até 24h · dias úteis</span>
    </div>
  </div>
</section>

<style>
  /* Vault section forces a dark backdrop in both themes.
     Remap local tokens so cards stay readable regardless of page theme. */
  .process-section {
    --bg: oklch(0.11 0.012 210);
    --bg-elev: oklch(0.15 0.015 205);
    --fg: oklch(0.97 0.008 85);
    color-scheme: dark;
  }

  .process-lede {
    max-width: 60ch;
    margin: -0.25rem 0 2.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: color-mix(in oklch, var(--fg) 65%, transparent);
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: color-mix(in oklch, var(--fg) 7%, transparent);
    border: 1px solid color-mix(in oklch, var(--fg) 7%, transparent);
    border-radius: 14px;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .process-card {
    background: var(--bg);
    padding: 1.75rem 1.5rem 1.5rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    transition: background 300ms ease;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 11rem;
  }
  .process-ghost {
    position: absolute;
    top: -0.4rem;
    right: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(5rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: color-mix(in oklch, var(--color-teal) 8%, transparent);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    transition: color 400ms var(--ease-emph);
  }
  .process-card:hover .process-ghost {
    color: color-mix(in oklch, var(--color-teal) 14%, transparent);
  }
  .process-card > *:not(.process-ghost) {
    position: relative;
    z-index: 1;
  }
  .process-card::before {
    /* subtle teal corner glyph */
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 18px;
    height: 18px;
    border-top: 1px solid color-mix(in oklch, var(--color-teal) 55%, transparent);
    border-left: 1px solid color-mix(in oklch, var(--color-teal) 55%, transparent);
    border-top-left-radius: 6px;
    opacity: 0.55;
    transition: opacity 300ms ease;
    z-index: 2;
  }
  .process-card:hover {
    background: color-mix(in oklch, var(--bg-elev) 60%, var(--bg));
  }
  .process-card:hover::before {
    opacity: 1;
  }

  /* Accent treatment for the final "Recusa honesta" card.
     A 2px teal left edge marks the rare-but-honest commitment. */
  .process-card--accent {
    box-shadow: inset 2px 0 0 0 color-mix(in oklch, var(--color-teal) 65%, transparent);
  }
  .process-card--accent .process-num::before {
    content: "// ";
    color: color-mix(in oklch, var(--color-teal) 70%, transparent);
  }

  .process-card-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .process-num {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: color-mix(in oklch, var(--color-teal) 65%, transparent);
  }

  .process-title {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: color-mix(in oklch, var(--fg) 92%, transparent);
  }

  .process-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: color-mix(in oklch, var(--fg) 62%, transparent);
    max-width: 42ch;
  }

  .process-meta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--fg) 38%, transparent);
  }

  .process-cta {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }
  .process-cta-meta {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--fg) 45%, transparent);
  }
</style>
