---
/**
 * ThemeToggle — sticky button (bottom-right) that toggles light/dark.
 * Default theme is light. Preference is persisted in localStorage.
 * The <html data-theme> attribute is set pre-paint by an inline script
 * in Base.astro to avoid a FOUC.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Alternar tema"
  title="Alternar tema"
>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5" />
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="12" y1="2.5" x2="12" y2="5" />
      <line x1="12" y1="19" x2="12" y2="21.5" />
      <line x1="2.5" y1="12" x2="5" y2="12" />
      <line x1="19" y1="12" x2="21.5" y2="12" />
      <line x1="5.2" y1="5.2" x2="7" y2="7" />
      <line x1="17" y1="17" x2="18.8" y2="18.8" />
      <line x1="5.2" y1="18.8" x2="7" y2="17" />
      <line x1="17" y1="7" x2="18.8" y2="5.2" />
    </g>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a0.6 0.6 0 0 0 -0.85 -0.66 9 9 0 1 0 12 12 0.6 0.6 0 0 0 -0.66 -0.85z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: inline-grid;
    place-items: center;
    background: color-mix(in oklch, var(--bg) 70%, transparent);
    color: var(--fg);
    border: 1px solid color-mix(in oklch, var(--fg) 18%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow: 0 6px 22px -8px color-mix(in oklch, var(--color-teal) 40%, transparent);
    cursor: pointer;
    transition: transform 260ms var(--ease-emph), border-color 220ms ease,
      background 220ms ease, box-shadow 220ms ease;
  }
  .theme-toggle:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-teal) 55%, transparent);
    color: var(--color-teal);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .theme-toggle {
      right: 1.5rem;
      bottom: 1.5rem;
      width: 48px;
      height: 48px;
    }
  }

  .theme-toggle .icon {
    width: 20px;
    height: 20px;
    transition: opacity 220ms ease, transform 360ms var(--ease-emph);
    grid-area: 1 / 1;
  }

  /* Default (light) → show moon (click to go dark) */
  .icon-sun { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .icon-moon { opacity: 1; transform: rotate(0) scale(1); }

  /* Dark → show sun (click to go light) */
  :root[data-theme="dark"] .icon-sun { opacity: 1; transform: rotate(0) scale(1); }
  :root[data-theme="dark"] .icon-moon { opacity: 0; transform: rotate(90deg) scale(0.6); }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle .icon { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (_) {}
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "dark" ? "#0a1518" : "#f3f0e8");
    });
  })();
</script>
