---
/**
 * Button — primary (filled teal) or ghost (text link).
 */
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  external?: boolean;
  class?: string;
}
const { href, variant = "primary", external = false, class: klass = "" } = Astro.props;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{variant === "primary" ? (
  <a
    href={href}
    rel={rel}
    target={target}
    class:list={[
      "group inline-flex items-center gap-2.5 rounded-full",
      "bg-[var(--color-teal)] text-[var(--color-ink-deep)]",
      "px-5 md:px-6 py-2.5 md:py-3 text-[0.92rem] font-medium",
      "hover:bg-white transition-colors",
      klass,
    ]}
  >
    <slot />
    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </a>
) : (
  <a
    href={href}
    rel={rel}
    target={target}
    class:list={[
      "inline-flex items-center gap-2 text-[0.92rem]",
      "text-white/55 hover:text-white transition-colors px-2 py-2.5",
      klass,
    ]}
  >
    <slot />
    {external && <span aria-hidden="true">↗</span>}
  </a>
)}
