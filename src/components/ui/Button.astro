---
/**
 * Button — primary (filled teal) or ghost (text link).
 */
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  external?: boolean;
  class?: string;
}
const { href, variant = "primary", external = false, class: klass = "" } = Astro.props;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{variant === "primary" ? (
  <a
    href={href}
    rel={rel}
    target={target}
    class:list={[
      "btn-primary group inline-flex items-center gap-2.5 rounded-full",
      "px-5 md:px-6 py-2.5 md:py-3 text-[0.92rem] font-medium",
      klass,
    ]}
  >
    <slot />
    <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </a>
) : (
  <a
    href={href}
    rel={rel}
    target={target}
    class:list={[
      "btn-ghost inline-flex items-center gap-2 text-[0.92rem]",
      "px-2 py-2.5",
      klass,
    ]}
  >
    <slot />
    {external && <span aria-hidden="true">↗</span>}
  </a>
)}

<style>
  .btn-primary {
    background: var(--color-teal);
    color: var(--color-ink-deep);
    box-shadow:
      0 1px 0 color-mix(in oklch, #ffffff 35%, transparent) inset,
      0 0 0 0 color-mix(in oklch, var(--color-teal) 0%, transparent),
      0 10px 30px -12px color-mix(in oklch, var(--color-teal) 55%, transparent);
    transition:
      background 300ms var(--ease-emph),
      box-shadow 400ms var(--ease-emph),
      transform 300ms var(--ease-emph);
  }
  .btn-primary:hover {
    background: color-mix(in oklch, var(--color-teal) 92%, white);
    box-shadow:
      0 1px 0 color-mix(in oklch, #ffffff 45%, transparent) inset,
      0 0 0 6px color-mix(in oklch, var(--color-teal) 18%, transparent),
      0 18px 40px -14px color-mix(in oklch, var(--color-teal) 70%, transparent);
    transform: translateY(-1px);
  }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 5px var(--color-teal);
  }

  .btn-ghost {
    color: color-mix(in oklch, var(--fg) 65%, transparent);
    border-radius: 999px;
    transition: color 300ms var(--ease-emph), background 300ms var(--ease-emph);
  }
  .btn-ghost:hover {
    color: var(--fg);
    background: color-mix(in oklch, var(--fg) 5%, transparent);
  }
  .btn-ghost:focus-visible {
    outline: none;
    color: var(--fg);
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px color-mix(in oklch, var(--color-teal) 55%, transparent);
  }
</style>
