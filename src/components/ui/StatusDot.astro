---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<p class="inline-flex items-center gap-2 text-sm text-white/80">
  <span class="relative flex w-1.5 h-1.5">
    <span class="absolute inset-0 rounded-full bg-[var(--color-teal)] animate-ping opacity-60"></span>
    <span class="relative rounded-full w-1.5 h-1.5 bg-[var(--color-teal)]"></span>
  </span>
  {label}
</p>
