---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  meta?: string;
  align?: "left" | "center";
  class?: string;
}
const { eyebrow, meta, align = "left", class: klass = "" } = Astro.props;
---

<header class:list={["mb-8 md:mb-12", align === "center" ? "text-center" : "", klass]}>
  <Eyebrow
    label={eyebrow}
    meta={meta}
    class={align === "center" ? "justify-center" : ""}
  />
  <h2 class="display text-[clamp(1.75rem,4.5vw,3.25rem)] mt-4 leading-[0.98]" style="letter-spacing:-0.025em">
    <slot />
  </h2>
</header>
